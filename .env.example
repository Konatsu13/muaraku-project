# ========================================
# SUPABASE CONFIGURATION
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Browser-safe client key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Fallback client anon key (compatible with both key conventions):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: used exclusively in server routes / background jobs requiring elevated administrative access
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# ========================================
# CLOUDFLARE TURNSTILE (CAPTCHA / BOT DEFENSE)
# ========================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ========================================
# TRANSLATION PROVIDER (ON-DEMAND LOCALIZATION)
# ========================================
# Server-only Google Cloud Translation API key:
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translate_api_key_here

# ========================================
# AI ASSISTANT PROVIDERS (MUARA AI & N2L)
# ========================================
# OpenAI API Key (optional):
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
